# Backend Environment Variables Template
# Copy this to .env and fill in the values

# Flask Settings
JWT_SECRET=jdlx_secret_keys_123

# Google OAuth Settings
# Get from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback
# ADMIN_GOOGLE_REDIRECT_URI=http://localhost:5000/admin/auth/google/callback
# PARTNER_GOOGLE_REDIRECT_URI=http://localhost:5000/partner/auth/google/callback
# ADMIN_GOOGLE_CLIENT_ID=your_admin_google_client_id_here
# ADMIN_GOOGLE_CLIENT_SECRET=your_admin_google_client_secret_here
# PARTNER_GOOGLE_CLIENT_ID=your_partner_google_client_id_here
# PARTNER_GOOGLE_CLIENT_SECRET=your_partner_google_client_secret_here

# Frontend URLs (for redirection)
# ADMIN_FRONTEND_URL=http://localhost:5174
# WAREHOUSE_FRONTEND_URL=http://localhost:5175
# STORE_FRONTEND_URL=http://localhost:5173

# Gmail SMTP Settings (For notifications)
# For Gmail, use an "App Password" if 2FA is enabled
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-digit-app-password

# Production CORS Origins (comma separated)
# CORS_ORIGINS=https://your-store.vercel.app,https://your-admin.vercel.app

# Custom Database Path (optional)
# DATABASE_PATH=/path/to/your/persistent/jdlx.db

# Backend Environment Variables Template
# Copy this to .env and fill in the values

# Flask Settings
JWT_SECRET=change_me_to_a_long_random_string

# Google OAuth Settings
# Get from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback
# ADMIN_GOOGLE_REDIRECT_URI=http://localhost:5000/admin/auth/google/callback
# PARTNER_GOOGLE_REDIRECT_URI=http://localhost:5000/partner/auth/google/callback
# ADMIN_GOOGLE_CLIENT_ID=your_admin_google_client_id_here
# ADMIN_GOOGLE_CLIENT_SECRET=your_admin_google_client_secret_here
# PARTNER_GOOGLE_CLIENT_ID=your_partner_google_client_id_here
# PARTNER_GOOGLE_CLIENT_SECRET=your_partner_google_client_secret_here

# Frontend URLs (for redirection)
# ADMIN_FRONTEND_URL=http://localhost:5174
# WAREHOUSE_FRONTEND_URL=http://localhost:5175
# STORE_FRONTEND_URL=http://localhost:5173

# Gmail SMTP Settings (For notifications)
# For Gmail, use an "App Password" if 2FA is enabled
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-digit-app-password

# Transactional email over HTTPS (RECOMMENDED for production/Render).
# Gmail SMTP is throttled/blocked from datacenter IPs (e.g. Render), which
# makes OTP emails time out. The HTTP APIs below are immune to that block.
# Priority: Resend -> MailerSend -> Gmail SMTP. MAIL_PROVIDER=smtp forces SMTP.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=JDLX Mobile <no-reply@yourdomain.com>  (domain must be verified in Resend)
# MAILERSEND_API_KEY=mlsn.your_api_key
# MAILERSEND_FROM_EMAIL=no-reply@yourdomain.com  (domain must be verified in MailerSend)
# MAIL_PROVIDER=auto

# Razorpay Settings
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Shiprocket Settings
SHIPROCKET_EMAIL=your_shiprocket_email@gmail.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_CHANNEL_ID=your_channel_id

# Production CORS Origins (comma separated)
# CORS_ORIGINS=https://your-store.vercel.app,https://your-admin.vercel.app

# Web Push (VAPID) — phone/browser push notifications (no Firebase needed)
# Generate a keypair once: `npx web-push generate-vapid-keys`.
# Put the PRIVATE key here and the PUBLIC key in frontend-store/.env as
# VITE_VAPID_PUBLIC_KEY. VAPID_SUBJECT must be a mailto: address.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# Custom Database Path (optional)
# DATABASE_PATH=/path/to/your/persistent/jdlx.db


# Frontend Environment Variables Template
# Copy this to .env (or .env.local)

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Razorpay Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VITE_GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_PLACE_ID/review

# Web Push (VAPID) — phone/browser push notifications (bell works without this,
# but to receive notifications when the app is closed it is required).
# Generate a keypair once: `npx web-push generate-vapid-keys`.
# Put the PUBLIC key here and the PRIVATE key in backend/.env as VAPID_PRIVATE_KEY.
VITE_VAPID_PUBLIC_KEY=
